{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // @rntp/player liefert über die Bedingung "react-native" seinen TS-Quellcode aus, der einen
      // in RN 0.88 nicht mehr typisierten Deep-Import nutzt. Für die Typprüfung daher die
      // mitgelieferten .d.ts-Dateien verwenden (Metro nutzt weiterhin den Quellcode).
      "@rntp/player": ["./node_modules/@rntp/player/lib/typescript/src/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
